{
  "name": "cinemalibrary-app",
  "version": "1.1.1",
  "description": "Cinema Library — Watch Movies & TV, as a Windows desktop app.",
  "author": "Tomas Nunes",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "make-icon": "node scripts/make-icon.js",
    "start": "node scripts/make-icon.js && electron .",
    "build": "node scripts/make-icon.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.nunesnetwork.cinemalibrary",
    "productName": "Cinema Library",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload-main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "cinemalibrary-windows.setup.${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cinema Library"
    }
  }
}
